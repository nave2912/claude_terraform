{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/schemas/machine-learning-workspace.schema.json",
  "title": "machine_learning_workspace Model",
  "description": "AI-scaffolded schema for JSON-driven machine_learning_workspace definitions — verify field constraints before use.",
  "type": "object",
  "required": [
    "machine_learning_workspaces"
  ],
  "additionalProperties": false,
  "properties": {
    "machine_learning_workspaces": {
      "type": "object",
      "description": "Map keyed by a stable logical id. The key becomes the for_each key in Terraform.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "location",
          "resource_group_name",
          "tags",
          "application_insights_id",
          "key_vault_id",
          "storage_account_id",
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Must follow naming convention: <workload>-<env> (lowercase, hyphen-separated)"
          },
          "location": {
            "type": "string",
            "minLength": 3
          },
          "resource_group_name": {
            "type": "string",
            "minLength": 1,
            "description": "Must match the \"name\" of an entry in resource-group.json."
          },
          "tags": {
            "type": "object",
            "required": [
              "environment",
              "owner",
              "costCenter",
              "application",
              "dataClassification"
            ],
            "properties": {
              "environment": {
                "type": "string",
                "enum": [
                  "dev",
                  "qa",
                  "prod"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "costCenter": {
                "type": "string",
                "minLength": 1
              },
              "application": {
                "type": "string",
                "minLength": 1
              },
              "dataClassification": {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              }
            },
            "additionalProperties": true
          },
          "application_insights_id": {
            "type": "string",
            "description": "The fully-qualified resource ID of the Application Insights instance used to monitor the workspace and collect telemetry data."
          },
          "key_vault_id": {
            "type": "string",
            "description": "The fully-qualified resource ID of the Key Vault used to store secrets, certificates, and keys for the workspace."
          },
          "storage_account_id": {
            "type": "string",
            "description": "The fully-qualified resource ID of the Storage Account used as the default storage for the workspace."
          },
          "identity": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "identity_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "type": {
                  "type": "string"
                }
              },
              "additionalProperties": true,
              "required": [
                "type"
              ]
            }
          },
          "container_registry_id": {
            "type": "string",
            "description": "The fully-qualified resource ID of an Azure Container Registry to associate with the workspace for storing Docker images used in training and deployment."
          },
          "description": {
            "type": "string",
            "description": "A free-text description of the Machine Learning workspace for documentation purposes."
          },
          "friendly_name": {
            "type": "string",
            "description": "A human-friendly display name for the workspace shown in the Azure Machine Learning studio and portal."
          },
          "high_business_impact": {
            "type": "boolean",
            "description": "Whether the workspace is subject to high business impact requirements, which enables additional data protection and compliance features."
          },
          "image_build_compute_name": {
            "type": "string",
            "description": "The name of the compute cluster to use for building Docker images. If not specified, images are built using Azure Container Instances."
          },
          "kind": {
            "type": "string",
            "description": "The kind of Machine Learning workspace to create. Determines the feature set and capabilities available."
          },
          "primary_user_assigned_identity": {
            "type": "string",
            "description": "The fully-qualified resource ID of the user-assigned managed identity to use as the primary identity for the workspace when multiple identities are configured."
          },
          "public_access_behind_virtual_network_enabled": {
            "type": "boolean",
            "description": "Whether to allow public network access to the workspace when it is configured behind a virtual network. Deprecated in favor of public_network_access_enabled."
          },
          "public_network_access_enabled": {
            "type": "boolean",
            "description": "Whether to allow public network access to the workspace. When false, the workspace can only be accessed through private endpoints."
          },
          "sku_name": {
            "type": "string",
            "description": "The SKU/pricing tier for the workspace. Determines the capabilities and capacity available."
          },
          "v1_legacy_mode_enabled": {
            "type": "boolean",
            "description": "Whether to enable v1 legacy mode for backward compatibility with older Machine Learning SDK versions and features."
          },
          "encryption": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key_id": {
                  "type": "string"
                },
                "key_vault_id": {
                  "type": "string"
                },
                "user_assigned_identity_id": {
                  "type": "string"
                }
              },
              "additionalProperties": true,
              "required": [
                "key_id",
                "key_vault_id"
              ]
            }
          },
          "feature_store": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "computer_spark_runtime_version": {
                  "type": "string"
                },
                "offline_connection_name": {
                  "type": "string"
                },
                "online_connection_name": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "managed_network": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "isolation_mode": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "serverless_compute": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "public_ip_enabled": {
                  "type": "boolean"
                },
                "subnet_id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "timeouts": {
            "type": "object",
            "properties": {
              "create": {
                "type": "string"
              },
              "delete": {
                "type": "string"
              },
              "read": {
                "type": "string"
              },
              "update": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
