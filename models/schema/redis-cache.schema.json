{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/schemas/redis-cache.schema.json",
  "title": "redis_cache Model",
  "description": "AI-scaffolded schema for JSON-driven redis_cache definitions — verify field constraints before use.",
  "type": "object",
  "required": [
    "redis_caches"
  ],
  "additionalProperties": false,
  "properties": {
    "redis_caches": {
      "type": "object",
      "description": "Map keyed by a stable logical id. The key becomes the for_each key in Terraform.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "location",
          "resource_group_name",
          "tags",
          "capacity",
          "family",
          "sku_name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Must follow naming convention: <workload>-<env> (lowercase, hyphen-separated)"
          },
          "location": {
            "type": "string",
            "minLength": 3
          },
          "resource_group_name": {
            "type": "string",
            "minLength": 1,
            "description": "Must match the \"name\" of an entry in resource-group.json."
          },
          "tags": {
            "type": "object",
            "required": [
              "environment",
              "owner",
              "costCenter",
              "application",
              "dataClassification"
            ],
            "properties": {
              "environment": {
                "type": "string",
                "enum": [
                  "dev",
                  "qa",
                  "prod"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "costCenter": {
                "type": "string",
                "minLength": 1
              },
              "application": {
                "type": "string",
                "minLength": 1
              },
              "dataClassification": {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              }
            },
            "additionalProperties": true
          },
          "capacity": {
            "type": "number",
            "description": "The size of the Redis cache to deploy. Valid values depend on the family: for C (Basic/Standard) family, use 0-6; for P (Premium) family, use 1-5."
          },
          "family": {
            "type": "string",
            "description": "The SKU family to use. Valid values are C (for Basic/Standard SKUs) or P (for Premium SKUs)."
          },
          "sku_name": {
            "type": "string",
            "description": "The SKU (pricing tier) of the Redis cache. Valid values are Basic, Standard, or Premium."
          },
          "enable_non_ssl_port": {
            "type": "boolean",
            "description": "Whether to enable the non-SSL port (6379). This field is deprecated; use non_ssl_port_enabled instead.",
            "default": false
          },
          "minimum_tls_version": {
            "type": "string",
            "description": "The minimum TLS version required for client connections. Valid values are 1.0, 1.1, or 1.2.",
            "default": "1.2"
          },
          "non_ssl_port_enabled": {
            "type": "boolean",
            "description": "Whether to enable the non-SSL port (6379) for unencrypted connections to the cache.",
            "default": false
          },
          "private_static_ip_address": {
            "type": "string",
            "description": "The static private IP address to assign to the Redis cache when deployed in a virtual network. Only available for Premium SKU."
          },
          "public_network_access_enabled": {
            "type": "boolean",
            "description": "Whether public network access is allowed to the Redis cache. Set to false to restrict access to private endpoints only.",
            "default": false
          },
          "redis_version": {
            "type": "string",
            "description": "The version of Redis to use. Valid values are 4 or 6. Defaults to 6 if not specified."
          },
          "replicas_per_master": {
            "type": "number",
            "description": "The number of replicas per master node. This field is deprecated; use replicas_per_primary instead. Only available for Premium SKU."
          },
          "replicas_per_primary": {
            "type": "number",
            "description": "The number of replicas per primary node for high availability. Only available for Premium SKU."
          },
          "shard_count": {
            "type": "number",
            "description": "The number of shards to create on a Premium Cluster cache. Only available for Premium SKU when clustering is enabled."
          },
          "subnet_id": {
            "type": "string",
            "description": "The ID of the subnet within a virtual network where the Redis cache should be deployed. Only available for Premium SKU."
          },
          "tenant_settings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "A map of tenant-specific settings to configure for the Redis cache."
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A set of availability zones where the Redis cache should be deployed for high availability. Only available for Premium SKU in supported regions."
          },
          "identity": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "identity_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "type": {
                  "type": "string"
                }
              },
              "additionalProperties": true,
              "required": [
                "type"
              ]
            }
          },
          "patch_schedule": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day_of_week": {
                  "type": "string"
                },
                "maintenance_window": {
                  "type": "string"
                },
                "start_hour_utc": {
                  "type": "number"
                }
              },
              "additionalProperties": true,
              "required": [
                "day_of_week"
              ]
            }
          },
          "redis_configuration": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "active_directory_authentication_enabled": {
                  "type": "boolean"
                },
                "aof_backup_enabled": {
                  "type": "boolean"
                },
                "aof_storage_connection_string_0": {
                  "type": "string"
                },
                "aof_storage_connection_string_1": {
                  "type": "string"
                },
                "authentication_enabled": {
                  "type": "boolean"
                },
                "data_persistence_authentication_method": {
                  "type": "string"
                },
                "enable_authentication": {
                  "type": "boolean"
                },
                "maxfragmentationmemory_reserved": {
                  "type": "number"
                },
                "maxmemory_delta": {
                  "type": "number"
                },
                "maxmemory_policy": {
                  "type": "string"
                },
                "maxmemory_reserved": {
                  "type": "number"
                },
                "notify_keyspace_events": {
                  "type": "string"
                },
                "rdb_backup_enabled": {
                  "type": "boolean"
                },
                "rdb_backup_frequency": {
                  "type": "number"
                },
                "rdb_backup_max_snapshot_count": {
                  "type": "number"
                },
                "rdb_storage_connection_string": {
                  "type": "string"
                },
                "storage_account_subscription_id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "timeouts": {
            "type": "object",
            "properties": {
              "create": {
                "type": "string"
              },
              "delete": {
                "type": "string"
              },
              "read": {
                "type": "string"
              },
              "update": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
